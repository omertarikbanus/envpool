+int MdlSimDriver::penalizedCollisionCount() const {
+  if (!_model || !_data) return 0;
+  // MuJoCo folds each URDF fixed foot link into its parent knee body. A
+  // foot-ground contact therefore reports the knee as geom_bodyid even though
+  // the contacting geom is the named foot sphere. Exclude those four geoms
+  // explicitly so ordinary support contacts are not charged as calf strikes.
+  std::array<int, 4> foot_geom_ids{};
+  for (int leg = 0; leg < 4; ++leg) {
+    const std::string name = "go2/foot_" + std::to_string(leg + 1);
+    foot_geom_ids[leg] = mj_name2id(_model, mjOBJ_GEOM, name.c_str());
+  }
+  std::vector<bool> colliding_body(static_cast<std::size_t>(_model->nbody),
+                                   false);
+  for (int contact_idx = 0; contact_idx < _data->ncon; ++contact_idx) {
+    const mjContact& contact = _data->contact[contact_idx];
+    mjtNum force[6]{};
+    mj_contactForce(_model, _data, contact_idx, force);
+    if (std::sqrt(force[0] * force[0] + force[1] * force[1] +
+                  force[2] * force[2]) <= 0.1) {
+      continue;
+    }
+    for (const int geom : {contact.geom1, contact.geom2}) {
+      if (geom < 0 || geom >= _model->ngeom) continue;
+      if (std::find(foot_geom_ids.begin(), foot_geom_ids.end(), geom) !=
+          foot_geom_ids.end()) {
+        continue;
+      }
+      const int body = _model->geom_bodyid[geom];
+      // The detailed URDF calf mesh reaches into the foot sphere's support
+      // patch (unlike Unitree's simplified training collision capsules), so a
+      // normal stance also creates a second floor contact on the knee body.
+      // Treat contacts inside the corresponding foot sphere's immediate
+      // support neighbourhood as foot support. Calf contacts farther up the
+      // link remain penalized.
+      bool in_foot_support_patch = false;
+      for (const int foot_geom : foot_geom_ids) {
+        if (foot_geom < 0 || _model->geom_bodyid[foot_geom] != body) continue;
+        const mjtNum* foot_position = _data->geom_xpos + 3 * foot_geom;
+        const mjtNum dx = contact.pos[0] - foot_position[0];
+        const mjtNum dy = contact.pos[1] - foot_position[1];
+        const mjtNum dz = contact.pos[2] - foot_position[2];
+        if (std::sqrt(dx * dx + dy * dy + dz * dz) <= 0.04) {
+          in_foot_support_patch = true;
+          break;
+        }
+      }
+      if (in_foot_support_patch) continue;
+      const char* name = mj_id2name(_model, mjOBJ_BODY, body);
+      if (name && (std::strstr(name, "/hip_") ||
+                   std::strstr(name, "/knee_"))) {
+        colliding_body[static_cast<std::size_t>(body)] = true;
+      }
+    }
+  }
+  return static_cast<int>(
+      std::count(colliding_body.begin(), colliding_body.end(), true));
+}
