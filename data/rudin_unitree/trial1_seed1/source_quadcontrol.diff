+SimRobotState MdlSimDriver::robotState() const {
+  SimRobotState out;
+  if (!_model || !_data || _model->nq < 7 || _model->nv < 6) return out;
+  for (int i = 0; i < 3; ++i) out.base_pos[i] = _data->qpos[i];
+  for (int i = 0; i < 4; ++i) out.base_quat_wxyz[i] = _data->qpos[3 + i];
+  for (int i = 0; i < 3; ++i) out.lin_vel_world[i] = _data->qvel[i];
+  // MuJoCo stores a free joint's angular velocity in the body frame; Isaac
+  // Gym's root state (and so legged_gym) holds it in the world frame.
+  mjtNum omega_world[3];
+  mju_rotVecQuat(omega_world, _data->qvel + 3, _data->qpos + 3);
+  for (int i = 0; i < 3; ++i) out.ang_vel_world[i] = omega_world[i];
+  if (_joint_mapping_valid) {
+    for (int axis = 0; axis < kNumAxes; ++axis) {
+      const int qadr = _axis_qpos_adr[axis];
+      const int dadr = _axis_dof_adr[axis];
+      const int act = _axis_to_actuator[axis];
+      out.q[axis] = (qadr >= 0) ? _data->qpos[qadr] : 0.0;
+      out.qd[axis] = (dadr >= 0) ? _data->qvel[dadr] : 0.0;
+      out.tau[axis] = (act >= 0 && act < _model->nu) ? _data->actuator_force[act]
+                                                      : 0.0;
+    }
+  }
+  return out;
+}
