+void MdlSimDriver::setRobotState(const SimRobotState& state) {
+  if (!_model || !_data || _model->nq < 7 || _model->nv < 6) return;
+  for (int i = 0; i < 3; ++i) _data->qpos[i] = state.base_pos[i];
+  mjtNum quat[4];
+  for (int i = 0; i < 4; ++i) quat[i] = state.base_quat_wxyz[i];
+  mju_normalize4(quat);
+  for (int i = 0; i < 4; ++i) _data->qpos[3 + i] = quat[i];
+  for (int i = 0; i < 3; ++i) _data->qvel[i] = state.lin_vel_world[i];
+  // World-frame angular velocity -> free-joint body frame.
+  mjtNum quat_inv[4];
+  mju_negQuat(quat_inv, quat);
+  mjtNum omega_world[3] = {state.ang_vel_world[0], state.ang_vel_world[1],
+                           state.ang_vel_world[2]};
+  mju_rotVecQuat(_data->qvel + 3, omega_world, quat_inv);
+  if (_joint_mapping_valid) {
+    for (int axis = 0; axis < kNumAxes; ++axis) {
+      if (_axis_qpos_adr[axis] >= 0) _data->qpos[_axis_qpos_adr[axis]] = state.q[axis];
+      if (_axis_dof_adr[axis] >= 0) _data->qvel[_axis_dof_adr[axis]] = state.qd[axis];
+    }
