+def _tracking_joint_pd(window: List[dict], tcol: str,
+                       onset: float) -> Dict[str, float]:
+    """Construct the joint-PD policy's commanded body trajectory.
+
+    The end-to-end policy has no body-pose controller. Its only exogenous
+    command is body-frame [vx, vy, yaw_rate], logged by MdlRLJointPD. Anchor the
+    planar trajectory and yaw at onset, integrate those commands, and use the
+    Unitree recipe's 0.25 m height with level roll/pitch.
+    """
+    out = {key: float("nan") for key in TRACKING_KEYS}
+    if len(window) < 2:
+        return out
+    anchor_pos = [_col(window[0], COL_POS.format(i)) for i in range(3)]
+    anchor_rpy = [_col(window[0], COL_RPY.format(i)) for i in range(3)]
+    if any(value is None for value in (*anchor_pos, *anchor_rpy)):
+        return out
+    desired_x, desired_y = anchor_pos[0], anchor_pos[1]
+    desired_yaw = anchor_rpy[2]
+    previous_t = _col(window[0], tcol)
+    samples = []
+    for row in window:
+        t = _col(row, tcol)
+        command = [_col(row, COL_CMD_VEL_PD.format(i)) for i in range(3)]
+        actual_pos = [_col(row, COL_POS.format(i)) for i in range(3)]
+        actual_rpy = [_col(row, COL_RPY.format(i)) for i in range(3)]
+        values = [t, *command, *actual_pos, *actual_rpy]
+        if any(value is None or not math.isfinite(value) for value in values):
+            continue
+        dt = max(0.0, t - previous_t)
+        desired_x += (math.cos(desired_yaw) * command[0] -
+                      math.sin(desired_yaw) * command[1]) * dt
+        desired_y += (math.sin(desired_yaw) * command[0] +
+                      math.cos(desired_yaw) * command[1]) * dt
+        desired_yaw += command[2] * dt
+        previous_t = t
+        pos_error = (actual_pos[0] - desired_x,
+                     actual_pos[1] - desired_y,
+                     actual_pos[2] - 0.25)
+        rpy_error = (actual_rpy[0], actual_rpy[1],
+                     _angle_error(actual_rpy[2], desired_yaw))
+        samples.append((t, pos_error, rpy_error))
+    return _tracking_from_error_samples(samples, onset)
+
+
+def _tracking_from_error_samples(samples, onset):
+    out = {key: float("nan") for key in TRACKING_KEYS}
+    if len(samples) < 2:
+        return out
+    duration = samples[-1][0] - samples[0][0]
+    if duration <= 0.0:
+        return out
+    for i, name in enumerate(("x", "y", "z")):
+        out[f"tracking_pos_rmse_{name}_m"] = math.sqrt(
+            _trapz(samples, lambda sample, j=i: sample[1][j] ** 2) / duration)
+        out[f"tracking_pos_iae_{name}_m_s"] = _trapz(
+            samples, lambda sample, j=i: abs(sample[1][j]))
+    for i, name in enumerate(("roll", "pitch", "yaw")):
+        out[f"tracking_rpy_rmse_{name}_rad"] = math.sqrt(
+            _trapz(samples, lambda sample, j=i: sample[2][j] ** 2) / duration)
+        out[f"tracking_rpy_iae_{name}_rad_s"] = _trapz(
+            samples, lambda sample, j=i: abs(sample[2][j]))
+    pos_norms = [math.sqrt(sum(value * value for value in sample[1]))
+                 for sample in samples]
+    rpy_norms = [math.sqrt(sum(value * value for value in sample[2]))
+                 for sample in samples]
+    out["tracking_peak_pos_error_m"] = max(pos_norms)
+    out["tracking_peak_rpy_error_rad"] = max(rpy_norms)
+    out["tracking_end_pos_error_m"] = pos_norms[-1]
+    out["tracking_end_rpy_error_rad"] = rpy_norms[-1]
+    within = [
+        all(abs(value) <= POSITION_SETTLE_TOL_M[i]
+            for i, value in enumerate(sample[1])) and
+        all(abs(value) <= ORIENTATION_SETTLE_TOL_RAD for value in sample[2])
+        for sample in samples
+    ]
+    settling = float("nan")
+    if samples[-1][0] >= onset + T_EVAL - WINDOW_TOL:
+        suffix = True
+        for i in range(len(samples) - 1, -1, -1):
+            suffix = suffix and within[i]
+            if suffix:
+                settling = max(0.0, samples[i][0] - onset)
+    out["tracking_settling_time_s"] = settling
+    return {key: _round(value) for key, value in out.items()}
+
