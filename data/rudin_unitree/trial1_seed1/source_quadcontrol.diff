+
+void MdlSimDriver::setActuatorForceLimits(const std::array<double, 3>& limits) {
+  if (!_model || !_joint_mapping_valid) return;
+  for (int axis = 0; axis < kNumAxes; ++axis) {
+    const int act = _axis_to_actuator[axis];
+    const double limit = limits[static_cast<std::size_t>(axis % 3)];
+    if (act < 0 || act >= _model->nu || !(limit > 0.0)) continue;
