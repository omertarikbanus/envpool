+    const bool attitude = std::abs(b.pitch) > 1.0 || std::abs(b.roll) > 0.8;
+    pd_time_out_ = elapsed_step_ > PDConstants::kMaxEpisodeLength;
+    const bool terminated =
+        terminate_when_unhealthy_ && (base_contact || attitude);
