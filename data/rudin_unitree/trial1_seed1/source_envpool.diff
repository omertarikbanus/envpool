+  void ResampleCommands() {
+    if (pd_fixed_command_) {
+      pd_commands_[0] = pd_fixed_vx_;
+      pd_commands_[1] = pd_fixed_vy_;
+      pd_commands_[3] = pd_fixed_heading_;
+      return;
+    }
