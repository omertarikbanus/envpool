+    const Eigen::Matrix<mjtNum, 3, 1> fwd =
+        b.R * Eigen::Matrix<mjtNum, 3, 1>(1.0, 0.0, 0.0);
+    b.heading = std::atan2(fwd[1], fwd[0]);
+    return b;
+  }
